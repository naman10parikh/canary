# wikimem
.wikimem-cache/
node_modules/

# canary CLI build artifacts (CP123 Wave B — never commit; built via `pnpm build`)
dist/
*.tsbuildinfo
# canary local OTLP span sink + scaffolded SLO rules (command outputs, not source)
.otel-out/
.slo/
# canary RSI deterministic-loop proposal output (a command output, not source)
.rsi/
# generated OTel/Sentry wiring canary writes INTO a target service (not canary's own source)
canary-otel.mjs
canary-sentry.config.mjs

# Playwright cockpit E2E (G29) — generated artifacts. Screenshots are chairman-facing run output;
# test-results/ + the HTML report are Playwright's. The .gitkeep keeps content/screenshots/ tracked.
test-results/
playwright-report/
content/screenshots/*.png
# runtime delivery-channel config (a chairman-provided secret-ish file, never committed)
.canary/

# WikiMem test vault personal data
my-wiki/raw/
tools/agentgrid/app/release/

packages/web/.next/
*.pack

# macOS metadata
**/.DS_Store

# Ephemeral harness state (never commit)
.claude/worktrees/
.claude/backups/
.claude/scheduled_tasks.lock
.claude/vp-signals/*.done
.claude/vp-signals/*.needs-qa
.claude/vp-signals/*.migrating

# Obsidian temp files
vault/Untitled*.base

.env
