# canary — Environment Variables (app-health / errors / uptime / observability employee)
# Copy to .env and fill in the keys for the tools you actually use. Defaults run at $0 / local-only:
# the acceptance test and `canary instrument` use a LOCAL file/in-memory OTLP exporter — no provider
# keys needed. Provider keys below light up the live paths (Sentry ingestion, Grafana/Prometheus query
# MCPs, synthetic uptime, real paging). NEVER commit .env. Names mirror brain/TOOL-MATRIX.md §3.

# ── Inherited (present in the repo .env per CP123 D7) ───────────────────────────
# Claude Code / Anthropic — the RSI Claude-half + any sub-agent canary spawns.
# Get at: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-...
# The deferred RSI Claude-half (D8) lights up only when this is set (see CHAIRMAN-CHECKLIST):
# CLAUDE_CODE_OAUTH_TOKEN=...

# E2B (Firecracker microVM) — the sandbox-boot integration test (the local-OTLP merge gate needs no key).
# Get at: https://e2b.dev/dashboard
E2B_API_KEY=e2b_...

# ── Errors + traces + release-health + Seer: Sentry ────────────────────────────
# SENTRY_AUTH_TOKEN — User Auth Token for the Sentry MCP/CLI/API.
#   read-only scopes: org:read, project:read, team:read
#   gated mutating path additionally needs: project:write, event:write
# Get at: https://sentry.io → Settings → Auth Tokens
# SENTRY_AUTH_TOKEN=...
# SENTRY_DSN — the *monitored app's* ingestion endpoint (goes in the app's Sentry.init, not a canary secret).
# SENTRY_DSN=https://...@o0.ingest.sentry.io/0

# ── Metrics + SLO/burn-rate: Prometheus + Grafana ──────────────────────────────
# PROMETHEUS_URL — required for the Prometheus MCP + API.
# PROMETHEUS_URL=http://localhost:9090
# Optional auth (deployment-dependent): basic auth OR a bearer token OR mTLS certs.
# PROMETHEUS_TOKEN=...
# ALERTMANAGER_URL — for amtool / Alertmanager config validation.
# ALERTMANAGER_URL=http://localhost:9093
# GRAFANA_URL + GRAFANA_API_KEY (service-account token) — the Grafana MCP/API.
#   RBAC note (TOOL-MATRIX §3): Viewer for reads; Editor to create incidents / modify Sift.
# GRAFANA_URL=http://localhost:3000
# GRAFANA_API_KEY=...

# ── Synthetic / uptime (monitoring-as-code): Checkly ───────────────────────────
# CHECKLY_API_KEY=...
# CHECKLY_ACCOUNT_ID=...

# ── On-call / paging: PagerDuty or incident.io ─────────────────────────────────
# PAGERDUTY_USER_API_TOKEN — User API Token for the PagerDuty MCP + REST API.
# PAGERDUTY_USER_API_TOKEN=...
# PAGERDUTY_ROUTING_KEY — integration/routing key to SEND events (Events API v2; always pair with a dedup_key).
# PAGERDUTY_ROUTING_KEY=...
# incident.io (alt on-call):
# INCIDENT_IO_API_KEY=...

# ── OpenTelemetry (instrument-once substrate) ──────────────────────────────────
# OTEL_EXPORTER_OTLP_ENDPOINT — where instrumented services export. Default acceptance path = local file.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# OTEL_EXPORTER_OTLP_HEADERS — may carry a secret (e.g. Authorization=Bearer <token>) for a hosted collector.
# OTEL_EXPORTER_OTLP_HEADERS=
# OTEL_SEMCONV_STABILITY_OPT_IN — pin/declare semconv stability (the gen_ai.* v1.42 repo-split, §9.1).
# OTEL_SEMCONV_STABILITY_OPT_IN=

# ── Uptime alt: BetterStack ────────────────────────────────────────────────────
# BETTERSTACK_API_TOKEN=...

# ── Inherited harness MCPs (env refs in .mcp.json — github needs a token for Seer's repo integration) ──
# GITHUB_PERSONAL_ACCESS_TOKEN=...
